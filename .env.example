# Copy to .env (or export these in your shell) and adjust as needed.
# Never commit a real .env file - see .gitignore.

# PostgreSQL (local database must already exist, e.g. `createdb crawler_db`)
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Hacker News scraper
HACKERNEWS_BASE_URL=https://news.ycombinator.com/
HACKERNEWS_TIMEOUT=5s

# CORS - comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
